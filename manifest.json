{
  "manifest_version": 3,
  "name": "Genius Lyrics & Notes for YouTube Music",
  "short_name": "Genius Sidebar",
  "version": "1.0.0",
  "description": "Adds a Genius tab to YouTube Music's sidebar: lyrics with annotated lines you can tap to read the notes, plus the song's About and credits.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://genius.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "sidebar.js"
      ],
      "css": [
        "sidebar.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
